// Renovate's shared rules come from the owner's preset repository.
{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"github>donvargax/renovate-config#v1.3.0",
		"github>donvargax/renovate-config:go#v1.3.0",
	],
	enabledManagers: ["gomod", "github-actions", "renovate-config"],

	// itos moves with its config pin and workflow action, not through Renovate.
	ignoreDeps: ["donvargax/itos"],
	automergeType: "branch",
	automergeSchedule: ["at any time"],
	semanticCommits: "enabled",
	commitBody: "Renovate's update, landed on {{{baseBranch}}} once CI passed on its branch.\n\n{{#each upgrades}}{{#unless @first}}\n{{/unless}}- {{{depName}}} {{#if (equals updateType 'digest')}}{{{currentDigestShort}}} to {{{newDigestShort}}}{{else}}{{{currentVersion}}} to {{{newVersion}}}{{#if newDigestShort}} ({{{newDigestShort}}}){{/if}}{{/if}}{{/each}}",

	packageRules: [
		{
			matchPackageNames: ["*"],
			semanticCommitType: "build",
			semanticCommitScope: null,
		},
		{
			matchManagers: ["github-actions", "renovate-config"],
			semanticCommitType: "ci",
			semanticCommitScope: null,
		},
		{
			matchManagers: ["github-actions"],
			pinDigests: true,
		},
		// itos refuses a build or ci commit without a Task footer, so every update commit names T-131,
		// the task that gave them the footer; a closed task stays in the ledger, so the footer keeps
		// validating. main is itos-cc's only base branch, so the rule matches every package rather
		// than a base branch, which Renovate's validator accepts only beside baseBranchPatterns.
		{
			matchPackageNames: ["*"],
			commitTrailers: ["Task: T-131"],
		},
		{
			// One dependency's updates share a branch name on every base branch, so they move together.
			matchPackageNames: ["*"],
			groupName: "{{depName}}",
		},
	],
}
