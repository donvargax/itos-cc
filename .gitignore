/itos-cc
/dist/
# Mutation results are committed, so later runs reuse their kills, and so are
# the crap, dry, scrap and graph snapshots the nightly records (T-190,
# T-210), so every clone has them; raw coverage and every other snapshot
# are not.
.metrics/*
!.metrics/mutate/
!.metrics/crap.json
!.metrics/dry.json
!.metrics/scrap.json
!.metrics/graph.json
.metrics/mutate/**/*.tmp
# The Node tools of the language smoke tests, installed with npm ci.
/testdata/tools/node/node_modules/
# Pinned tools downloaded for local use, by tools/bin/pinned.
/.tools/
# The Flutter SDK link fvm install makes from .fvmrc, for the Dart scenarios.
/.fvm/
