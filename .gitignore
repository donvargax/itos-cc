/itos-cc
/dist/
# Mutation results are committed, so later runs reuse their kills; raw
# coverage and the other snapshots are not.
.metrics/*
!.metrics/mutate/
.metrics/mutate/**/*.tmp
# The Node tools of the language smoke tests, installed with npm ci.
/testdata/tools/node/node_modules/
# Pinned tools downloaded for local use, by tools/bin/pinned.
/.tools/
# The Flutter SDK link fvm install makes from .fvmrc, for the Dart scenarios.
/.fvm/
