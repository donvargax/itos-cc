#!/bin/sh
# Exercise the actual pinned linter/configuration, without requiring template git history.
set -eu

usage() {
	echo "usage: tools/bin/architecture-check [--linked <package> | --siblings <package>... | --outside <package>...]" >&2
	exit 2
}

# linked <package>: refuse a binary linking a port's fake (T-56), which
# depguard cannot hold, seeing only the imports a file names, not what a
# binary links through them. go list -deps leaves _test.go files out, so a
# fake a command's tests import passes.
linked() {
	deps=$(go list -deps "$1")
	fakes=$(printf '%s\n' "$deps" | grep -E '/porttest(/|$)' || true)
	[ -z "$fakes" ] && return 0
	for fake in $fakes; do
		echo "architecture-check: $1 links $fake; a port's fake enters only through _test.go files" >&2
	done
	return 1
}

# siblings <package>...: refuse a package under internal/slices/X importing
# one under internal/slices/Y, from its code or its tests (ADR-0051), which
# depguard cannot hold: its deny list is a prefix, so refusing the slices
# would refuse a slice's own subpackages too. A slice may import its own
# subpackages and any engine; what is outside internal/slices importing a
# slice is outside's to hold, below. Every package under internal/slices/X,
# its domain and its adapters under internal/slices/X/adapters among them,
# is X's.
siblings() {
	prefix="$(go list -m)/internal/slices/"
	listed=$(go list -f '{{.ImportPath}}{{range .Imports}} {{.}}{{end}}{{range .TestImports}} {{.}}{{end}}{{range .XTestImports}} {{.}}{{end}}' "$@")
	refused=$(printf '%s\n' "$listed" | awk -v prefix="$prefix" '
		function slice(path, rest) {
			if (index(path, prefix) != 1) return ""
			rest = substr(path, length(prefix) + 1)
			if (index(rest, "/") > 0) rest = substr(rest, 1, index(rest, "/") - 1)
			return rest
		}
		{
			own = slice($1)
			if (own == "") next
			for (i = 2; i <= NF; i++) {
				other = slice($i)
				if (other != "" && other != own && !seen[$1 " " $i]++) print $1 " imports " $i
			}
		}')
	[ -z "$refused" ] && return 0
	printf '%s\n' "$refused" | while IFS= read -r line; do
		echo "architecture-check: $line; a slice imports no other slice (ADR-0051)" >&2
	done
	return 1
}

# outside <package>...: refuse a package outside internal/slices importing
# one under it, from its code or its tests, unless the importer is under
# cmd/, which assembles the slices, or a legacy consumer importing what its
# row allows (ADR-0051, T-167): engines stay behind stable APIs the slices
# import, never the reverse. depguard's slices rule covers internal/** only,
# and project, coverage, metrics, server, features and tools/ have no rule,
# so this holds it over the same go list fields as siblings. graph, the
# legacy serve consumer, its fixture subpackages with it, reads the
# mutation domain's judgment in its code, and its tests build fixtures with
# anything under internal/slices/mutation/; config, the one settings codec,
# decodes into the mutation domain's Config, and its tests use that
# domain's porttest.
outside() {
	module=$(go list -m)
	listed=$(go list -f '{{$p := .ImportPath}}{{range .Imports}}{{$p}} code {{.}}{{"\n"}}{{end}}{{range .TestImports}}{{$p}} tests {{.}}{{"\n"}}{{end}}{{range .XTestImports}}{{$p}} tests {{.}}{{"\n"}}{{end}}' "$@")
	refused=$(printf '%s\n' "$listed" | awk -v module="$module" '
		function under(path, folder) {
			return path == module "/" folder || index(path, module "/" folder "/") == 1
		}
		function allowed(importer, kind, imported, domain) {
			if (index(importer, module "/cmd/") == 1) return 1
			domain = module "/internal/slices/mutation/domain"
			if (under(importer, "graph")) {
				if (imported == domain) return 1
				return kind == "tests" && index(imported, module "/internal/slices/mutation/") == 1
			}
			if (under(importer, "config")) {
				if (imported == domain) return 1
				return kind == "tests" && imported == domain "/porttest"
			}
			return 0
		}
		NF == 3 && !under($1, "internal/slices") && under($3, "internal/slices") && !allowed($1, $2, $3) {
			if (seen[$1 " " $3]++) next
			from = ""
			if ($2 == "tests") from = " from its tests"
			print $1 " imports " $3 from
		}')
	[ -z "$refused" ] && return 0
	printf '%s\n' "$refused" | while IFS= read -r line; do
		echo "architecture-check: $line; only cmd imports any package under internal/slices, graph and config only what their rows in docs/go.md allow (ADR-0051)" >&2
	done
	return 1
}

# --linked <package>, --siblings <package>... and --outside <package>... run
# that check alone, in the current module: the fixtures prove each refuses.
case "${1-}" in
--linked)
	[ $# -eq 2 ] || usage
	linked "$2"
	exit 0
	;;
--siblings)
	[ $# -ge 2 ] || usage
	shift
	siblings "$@"
	exit 0
	;;
--outside)
	[ $# -ge 2 ] || usage
	shift
	outside "$@"
	exit 0
	;;
-*) usage ;;
esac
[ $# -eq 0 ] || usage

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"
linked ./cmd/itos-cc
siblings ./...
outside ./...
ARCHITECTURE_ROOT=$root
ARCHITECTURE_LINTER=$(tools/bin/pinned --path golangci-lint)
export ARCHITECTURE_ROOT ARCHITECTURE_LINTER
go test ./tools/testdata/architecture -count=1 -v
