{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/donvargax/itos-cc/tools/testdata/step-strictness/schema-v1.json",
  "title": "Reviewed scenario assertion edits, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root", "probes"],
  "properties": {
    "version": {"const": 1},
    "root": {"type": "string", "minLength": 1, "description": "Checkout root, slash path relative to this manifest."},
    "output_dir": {"type": "string", "pattern": "^[^,]*$", "default": "", "description": "New directory outside checkout, relative to the manifest. Empty or omitted: unique OS temporary directory. No Godog formatter separators."},
    "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 600, "default": 600},
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scenario_id", "source_path", "original", "replacement", "assertion"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "description": "Unique probe label."},
          "scenario_id": {"type": "string", "pattern": "^ID-[A-Z]+-[0-9]+$"},
          "source_path": {"type": "string", "minLength": 1, "description": "Non-symlink .go/.feature acceptance source under features, relative to this manifest."},
          "original": {"type": "string", "minLength": 1, "description": "Must occur exactly once in initial source, including unique surrounding text when needed."},
          "replacement": {"type": "string", "minLength": 1, "description": "Must differ from original."},
          "assertion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "line", "name", "error_token"],
            "properties": {
              "uri": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1, "description": "Exact expanded step name after the edit; whitespace/case are significant."},
              "error_token": {"type": "string", "minLength": 1, "pattern": "\\S", "description": "Reviewed assertion error substring, not a generic hook/setup failure."}
            }
          }
        }
      }
    }
  }
}
